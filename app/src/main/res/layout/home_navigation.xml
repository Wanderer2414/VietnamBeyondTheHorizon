<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:orientation="horizontal"
    android:background="@drawable/home_navigation_box"
    android:paddingVertical="2dp"
    android:elevation="5dp"
    android:gravity="center">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/navigation_discover_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintDimensionRatio="1:1"
        android:background="@drawable/ic_discover_outlined"
        android:backgroundTint="@color/background_forth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navigation_list_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginVertical="12dp"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/navigation_list_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintDimensionRatio="1:1"
        android:background="@drawable/ic_list_outlined"
        android:backgroundTint="@color/background_forth"
        app:layout_constraintStart_toEndOf="@id/navigation_discover_button"
        app:layout_constraintEnd_toStartOf="@id/navigation_home_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginVertical="12dp"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/navigation_home_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintDimensionRatio="1:1"
        android:background="@drawable/ic_home_outlined"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toEndOf="@id/navigation_list_button"
        app:layout_constraintEnd_toStartOf="@id/navigation_map_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginVertical="12dp"
        android:layout_marginHorizontal="10dp"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/navigation_map_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintDimensionRatio="1:1"
        android:background="@drawable/ic_map"
        android:backgroundTint="@color/background_forth"
        app:layout_constraintStart_toEndOf="@id/navigation_home_button"
        app:layout_constraintEnd_toStartOf="@id/navigation_setting_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginVertical="12dp"
        />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/navigation_setting_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintDimensionRatio="1:1"
        android:background="@drawable/ic_setting_outlined"
        android:backgroundTint="@color/background_forth"
        app:layout_constraintStart_toEndOf="@id/navigation_map_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginVertical="12dp"
        />

    <FrameLayout
        android:layout_width="70dp"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/home_navigation_select_box"
        app:layout_constraintEnd_toEndOf="@id/navigation_home_button"
        app:layout_constraintStart_toStartOf="@id/navigation_home_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>