<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_navigation_box"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:orientation="horizontal"
    android:background="@drawable/home_navigation_box"
    android:paddingVertical="2dp"
    android:elevation="5dp"
    android:gravity="center">

    <FrameLayout
        android:id="@+id/slide_button"
        android:layout_width="70dp"
        android:layout_height="match_parent"
        android:background="@drawable/home_navigation_select_box"
        app:layout_constraintEnd_toEndOf="@id/navigation_home_button"
        app:layout_constraintStart_toStartOf="@id/navigation_home_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />


    <View
        android:id="@+id/navigation_discover_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navigation_list_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <View
        android:id="@+id/navigation_list_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toEndOf="@id/navigation_discover_button"
        app:layout_constraintEnd_toStartOf="@id/navigation_home_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        android:id="@+id/navigation_home_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toEndOf="@id/navigation_list_button"
        app:layout_constraintEnd_toStartOf="@id/navigation_map_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />



    <View
        android:id="@+id/navigation_map_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navigation_setting_button"
        app:layout_constraintStart_toEndOf="@id/navigation_home_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <View
        android:id="@+id/navigation_setting_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toEndOf="@id/navigation_map_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


    <ImageView
        android:id="@+id/navigation_discover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/ic_discover_outlined"
        app:layout_constraintStart_toStartOf="@id/navigation_discover_button"
        app:layout_constraintEnd_toEndOf="@id/navigation_discover_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="@color/background_forth"/>


    <ImageView
        android:id="@+id/navigation_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/ic_list_outlined"
        app:layout_constraintStart_toStartOf="@id/navigation_list_button"
        app:layout_constraintEnd_toEndOf="@id/navigation_list_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="@color/background_forth"/>



    <ImageView
        android:id="@+id/navigation_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/ic_home_outlined"
        app:layout_constraintStart_toStartOf="@id/navigation_home_button"
        app:layout_constraintEnd_toEndOf="@id/navigation_home_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="@color/white" />


    <ImageView
        android:id="@+id/navigation_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/ic_map"
        app:layout_constraintStart_toStartOf="@id/navigation_map_button"
        app:layout_constraintEnd_toEndOf="@id/navigation_map_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="@color/background_forth"/>

    <ImageView
        android:id="@+id/navigation_setting"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/ic_setting_outlined"
        app:layout_constraintStart_toStartOf="@id/navigation_setting_button"
        app:layout_constraintEnd_toEndOf="@id/navigation_setting_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="@color/background_forth"/>

</androidx.constraintlayout.widget.ConstraintLayout>